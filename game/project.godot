; Engine configuration file.
; King's Domain — Godot 4.7.2

config_version=5

[application]

config/name="King's Domain"
config/description="Medieval-fantasy valley city builder and kingdom conquest."
run/main_scene="res://valley/valley.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Proj="*res://core/proj.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[input]

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=2
2d/snap/snap_2d_transforms_to_pixel=false
environment/defaults/default_clear_color=Color(0.16, 0.2, 0.17, 1)

[shader_globals]

cam_zoom={
"type": "float",
"value": 0.1
}

[importer_defaults]

texture={
"mipmaps/generate": true
}
