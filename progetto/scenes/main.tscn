[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/main.gd" id="1_main"]
[ext_resource type="PackedScene" path="res://scenes/local/local_view.tscn" id="2_local"]
[ext_resource type="PackedScene" path="res://scenes/global/global_view.tscn" id="3_global"]
[ext_resource type="Script" path="res://core/simulation/simulation_runner.gd" id="4_runner"]
[ext_resource type="Script" path="res://ui/settlement/settlement_hud.gd" id="5_hud"]
[ext_resource type="Script" path="res://ui/debug/debug_overlay.gd" id="6_debug"]

[node name="Main" type="Node2D"]
script = ExtResource("1_main")

[node name="SimulationRunner" type="Node" parent="."]
script = ExtResource("4_runner")

[node name="LocalView" parent="." instance=ExtResource("2_local")]

[node name="GlobalView" parent="." instance=ExtResource("3_global")]

[node name="SettlementHud" type="CanvasLayer" parent="."]
script = ExtResource("5_hud")
shell_path = NodePath("..")

[node name="DebugOverlay" type="CanvasLayer" parent="."]
script = ExtResource("6_debug")
runner_path = NodePath("../SimulationRunner")
