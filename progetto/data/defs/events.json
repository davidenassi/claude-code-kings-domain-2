    {"id": "fiera_di_primavera", "category": "economia", "title": "La fiera di primavera", "kind": "good", "weight": 7, "cooldown_days": 1080, "text": "Mercanti di tre valli chiedono di piantare le tende sul prato del villaggio per una settimana.", "when": {"season": "primavera", "has_settlement": true, "min_population": 30, "at_peace": true}, "options": [{"text": "Si apra il prato, e si prenda il dazio", "effects": {"treasury": 70, "trust": 4, "favour": {"merchants": 6}}, "ai": {"trade": 1.0, "greed": 0.5}}, {"text": "Niente dazio: che vengano in tanti", "effects": {"trust": 8, "prestige": 3, "favour": {"merchants": 10, "people": 4}}, "ai": {"trade": 0.6, "authority": -0.2}}]},
