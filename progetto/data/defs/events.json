    {"id": "sale_sul_fiume", "category": "economia", "title": "Il sale risale il fiume", "kind": "good", "weight": 6, "cooldown_days": 1440, "text": "Una chiatta carica di sale chiede di fermarsi al guado: il fiume è una strada, se qualcuno la sorveglia.", "when": {"capital_river": true, "at_peace": true, "min_population": 20}, "options": [{"text": "Un pedaggio al guado", "effects": {"treasury": 45, "favour": {"merchants": -2}, "crisis": {"id": "pedaggio_del_guado", "name": "Pedaggio del guado", "days": 720, "modifiers": [{"key": "trade.income", "op": "mul", "value": 1.15}]}}, "ai": {"greed": 1.0}}, {"text": "Il guado resta libero", "effects": {"favour": {"merchants": 8}, "prestige": 2}, "ai": {"trade": 1.0}}]},
