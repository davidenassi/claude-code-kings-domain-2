    {"id": "maestro_d_armi", "category": "guerra", "title": "Un maestro d'armi", "kind": "good", "weight": 5, "cooldown_days": 1800, "text": "Un vecchio capitano chiede di fermarsi: insegnerebbe ai giovani a tenere la lancia come si deve.", "when": {"crowned": true, "min_population": 30}, "options": [{"text": "Resti, con un salario", "effects": {"treasury": -35, "favour": {"army": 8}, "crisis": {"id": "addestramento", "name": "Un maestro d'armi", "days": 1440, "modifiers": [{"key": "military.infantry_defense", "op": "mul", "value": 1.1}]}}, "ai": {"aggression": 1.0}}, {"text": "Qui si ara, non si combatte", "effects": {"favour": {"people": 3, "army": -4}}, "ai": {"caution": 0.6, "trade": 0.3}}]},
    {"id": "disertori", "category": "guerra", "title": "Disertori nei boschi", "kind": "bad", "weight": 7, "cooldown_days": 720, "text": "Uomini scappati dall'esercito vivono nei boschi e rubano galline, a volte di peggio.", "when": {"at_war": true, "min_war_years": 1}, "options": [{"text": "Perdono a chi torna", "effects": {"favour": {"army": -4, "people": 3}, "legitimacy": -2}, "ai": {"piety": 0.6, "caution": 0.4}}, {"text": "La forca per tutti", "effects": {"stability": 6, "trust": -5, "favour": {"army": 5}}, "ai": {"authority": 0.8, "aggression": 0.5}}]},
    {"id": "ambasciatore_offeso", "category": "diplomazia", "title": "Un ambasciatore offeso", "kind": "bad", "weight": 6, "cooldown_days": 1080, "text": "L'inviato di un regno vicino è stato messo in fondo alla tavola. Se n'è andato senza salutare.", "when": {"crowned": true, "min_provinces": 2}, "options": [{"text": "Si mandino doni e scuse", "effects": {"treasury": -40, "opinion_neighbour": 10}, "ai": {"caution": 0.8, "trade": 0.5}}, {"text": "Che impari dove si siede", "effects": {"opinion_neighbour": -15, "prestige": 3}, "ai": {"aggression": 0.8, "authority": 0.4}}]},
    {"id": "mercanti_di_confine", "category": "diplomazia", "title": "I mercanti del confine", "kind": "good", "weight": 6, "cooldown_days": 1080, "text": "Il trattato di commercio ha portato carri e facce nuove: i mercanti chiedono un magazzino comune.", "when": {"has_pact": "trade"}, "options": [{"text": "Si costruisca a spese nostre", "effects": {"treasury": -50, "opinion_neighbour": 8, "crisis": {"id": "magazzino_comune", "name": "Magazzino comune", "days": 1800, "modifiers": [{"key": "trade.income", "op": "mul", "value": 1.12}]}}, "ai": {"trade": 1.0}}, {"text": "Paghino loro", "effects": {"treasury": 20, "opinion_neighbour": -4}, "ai": {"greed": 1.0}}]},
    {"id": "ostaggio_d_onore", "category": "diplomazia", "title": "Un ostaggio d'onore", "kind": "good", "weight": 4, "cooldown_days": 2160, "text": "Un alleato propone di scambiarsi un figlio di buona casa, da crescere a corte come pegno di fedeltà.", "when": {"has_pact": "alliance"}, "options": [{"text": "Si accetti lo scambio", "effects": {"opinion_neighbour": 15, "legitimacy": 2, "favour": {"nobility": 3}}, "ai": {"caution": 0.8}}, {"text": "Nessun figlio lascia la casa", "effects": {"opinion_neighbour": -6, "favour": {"nobility": 2}}, "ai": {"authority": 0.8}}]},
    {"id": "pellegrini", "category": "fede", "title": "Pellegrini sulla strada", "kind": "good", "weight": 7, "cooldown_days": 900, "text": "Una fila di pellegrini chiede riparo per la notte: vanno a un santuario lontano e pagano in preghiere.", "when": {"has_settlement": true, "at_peace": true}, "options": [{"text": "Si dia loro pane e un tetto", "effects": {"stock": {"bread": -20}, "favour": {"clergy": 6}, "prestige": 2}, "ai": {"piety": 1.0}}, {"text": "Si chieda un'offerta", "effects": {"treasury": 25, "favour": {"clergy": -4}}, "ai": {"greed": 1.0}}]},
    {"id": "decime", "category": "fede", "title": "Il vescovo chiede le decime", "kind": "bad", "weight": 6, "cooldown_days": 1440, "text": "Il vescovo ricorda che un decimo del raccolto spetta alla Chiesa, e che la corona lo sa bene.", "when": {"crowned": true, "favour_above": {"clergy": 55}, "min_provinces": 2}, "options": [{"text": "Si paghino le decime", "effects": {"stock": {"grain": -60}, "favour": {"clergy": 8}, "legitimacy": 3}, "ai": {"piety": 1.0}}, {"text": "La corona non paga nessuno", "effects": {"favour": {"clergy": -12, "nobility": 3}, "legitimacy": -3}, "ai": {"authority": 0.8, "greed": 0.5}}]},
    {"id": "reliquia", "category": "fede", "title": "Una reliquia in vendita", "kind": "good", "weight": 4, "cooldown_days": 2880, "once": true, "text": "Un mercante giura di avere il dito di un santo. Il sovrano, devoto, lo guarda a lungo.", "when": {"crowned": true, "ruler_trait": "pio", "min_treasury": 200}, "options": [{"text": "Si compri, e si costruisca una cappella", "effects": {"treasury": -180, "legitimacy": 8, "prestige": 6, "favour": {"clergy": 12}, "chronicle": "{Corona} compra una reliquia e le costruisce una cappella."}, "ai": {"piety": 1.0}}, {"text": "È un osso di pollo", "effects": {"favour": {"clergy": -5, "merchants": 2}}, "ai": {"greed": 0.5, "caution": 0.5}}]},
    {"id": "predicatore", "category": "fede", "title": "Un predicatore nelle piazze", "kind": "bad", "weight": 6, "cooldown_days": 1080, "text": "Un frate scalzo predica contro i ricchi e i signori. La gente lo ascolta, e non se ne va.", "when": {"crowned": true, "favour_below": {"people": 45}}, "options": [{"text": "Lo si ascolti, e si faccia qualcosa", "effects": {"treasury": -40, "favour": {"people": 8, "nobility": -4}}, "ai": {"piety": 0.8, "caution": 0.4}}, {"text": "Lo si cacci dal regno", "effects": {"stability": 5, "favour": {"people": -6, "clergy": -3}}, "ai": {"authority": 1.0}}]},
    {"id": "cantastorie", "category": "cultura", "title": "Un cantastorie", "kind": "good", "weight": 6, "cooldown_days": 1440, "text": "Un cantastorie canta la storia dei fondatori nella piazza. Qualcuno piange, tutti la imparano.", "when": {"has_settlement": true, "min_year": 8}, "options": [{"text": "Che la canti ogni anno", "effects": {"trust": 5, "prestige": 3, "treasury": -15}, "ai": {"trade": 0.4, "piety": 0.3}}, {"text": "Che la scriva, invece", "effects": {"research": 25, "prestige": 2}, "ai": {"authority": 0.6}}]},
    {"id": "lingua_della_corte", "category": "cultura", "title": "La lingua della corte", "kind": "bad", "weight": 6, "cooldown_days": 1800, "text": "Nelle terre nuove si parla un'altra lingua. I giudici del regno non capiscono chi giudicano.", "when": {"crowned": true, "min_foreign_provinces": 2}, "options": [{"text": "Giudici del posto", "effects": {"treasury": -50, "unrest": -0.1, "favour": {"nobility": -3}}, "ai": {"caution": 0.8, "trade": 0.3}}, {"text": "La legge si dice in una lingua sola", "effects": {"unrest": 0.08, "legitimacy": 2}, "ai": {"authority": 1.0}}]},
    {"id": "scuola_del_monastero", "category": "cultura", "title": "La scuola del monastero", "kind": "good", "weight": 5, "cooldown_days": 2160, "text": "I monaci offrono di insegnare a leggere ai figli delle famiglie, se la corona paga l'inchiostro.", "when": {"crowned": true, "min_year": 12, "min_population": 40}, "options": [{"text": "La corona paghi", "effects": {"treasury": -70, "research": 60, "favour": {"clergy": 5}}, "ai": {"authority": 0.5, "trade": 0.5}}, {"text": "Chi vuole leggere, paghi", "effects": {"research": 20, "favour": {"people": -2}}, "ai": {"greed": 0.8}}]},
    {"id": "piena_del_fiume", "category": "terra", "title": "La piena", "kind": "bad", "weight": 6, "cooldown_days": 1440, "text": "Dopo tre giorni di pioggia il fiume è uscito dagli argini e ha coperto i campi più bassi.", "when": {"capital_river": true, "season": "primavera", "has_settlement": true}, "options": [{"text": "Tutti agli argini", "effects": {"stock": {"grain": -30, "wood": -20}, "trust": -2}, "ai": {"caution": 1.0}}, {"text": "Si salvi il granaio, i campi si rifaranno", "effects": {"trust": -5, "crisis": {"id": "campi_allagati", "name": "Campi allagati", "days": 180, "modifiers": [{"key": "production.grain", "op": "mul", "value": 0.8}]}}, "ai": {"greed": 0.6}}]},
    {"id": "frana", "category": "terra", "title": "La frana", "kind": "bad", "weight": 5, "cooldown_days": 1800, "text": "Un costone è venuto giù sulla strada della valle. Sotto, però, c'è pietra buona.", "when": {"capital_mountain": true}, "options": [{"text": "Si liberi la strada e si tenga la pietra", "effects": {"stock": {"stone": 60}, "trust": -2}, "ai": {"greed": 0.8, "trade": 0.3}}, {"text": "Si giri intorno", "effects": {"crisis": {"id": "strada_chiusa", "name": "Strada chiusa", "days": 360, "modifiers": [{"key": "trade.income", "op": "mul", "value": 0.85}]}}, "ai": {"caution": 0.6}}]},
    {"id": "lupi", "category": "terra", "title": "I lupi", "kind": "bad", "weight": 6, "cooldown_days": 1080, "text": "Un branco scende dal bosco nelle notti di gelo: hanno già preso due pecore e un cane.", "when": {"season": "inverno", "capital_forest": 0.4, "has_settlement": true}, "options": [{"text": "Una battuta di caccia", "effects": {"trust": 3, "treasury": -10, "favour": {"nobility": 3}}, "ai": {"aggression": 0.8}}, {"text": "Si chiudano le stalle di notte", "effects": {"trust": -3}, "ai": {"caution": 1.0}}]},
    {"id": "siccita", "category": "terra", "title": "La siccità", "kind": "crisis", "weight": 5, "cooldown_days": 2160, "text": "Non piove da quaranta giorni. Il grano è basso e giallo, i pozzi si abbassano.", "when": {"season": "estate", "has_settlement": true, "min_year": 3}, "options": [{"text": "Si porti acqua dal fiume, a braccia", "effects": {"trust": -4, "crisis": {"id": "siccita_vinta", "name": "Siccità", "days": 90, "modifiers": [{"key": "production.grain", "op": "mul", "value": 0.85}]}}, "ai": {"caution": 0.8}}, {"text": "Si preghi per la pioggia", "effects": {"favour": {"clergy": 5}, "crisis": {"id": "siccita_dura", "name": "Siccità", "days": 120, "modifiers": [{"key": "production.grain", "op": "mul", "value": 0.65}]}}, "ai": {"piety": 1.0}}]},
    {"id": "complotto", "category": "crisi", "title": "Un complotto a corte", "kind": "crisis", "weight": 6, "cooldown_days": 2160, "text": "Una lettera intercettata: tre signori contano i giorni che mancano a un cambio di sovrano.", "when": {"crowned": true, "max_legitimacy": 50, "favour_below": {"nobility": 45}}, "options": [{"text": "Arresti, subito", "effects": {"stability": 6, "legitimacy": 4, "turbulence": 6, "favour": {"nobility": -10, "army": 4}}, "ai": {"authority": 1.0, "aggression": 0.5}}, {"text": "Li si compri", "effects": {"treasury": -120, "favour": {"nobility": 10}, "legitimacy": -2}, "ai": {"caution": 1.0, "greed": -0.4}}]},
    {"id": "rivolta_fiscale", "category": "crisi", "title": "Non si paga più", "kind": "crisis", "weight": 7, "cooldown_days": 1440, "text": "In tre villaggi hanno bruciato i registri delle tasse e cacciato l'esattore a sassate.", "when": {"crowned": true, "favour_below": {"people": 32}, "min_provinces": 3}, "options": [{"text": "Un anno di sconto", "effects": {"treasury": -80, "favour": {"people": 10}, "stability": 3}, "ai": {"caution": 1.0}}, {"text": "Si mandino i soldati", "effects": {"stability": 8, "trust": -8, "unrest": 0.1, "favour": {"people": -8, "army": 4}, "chronicle": "{Corona} doma una rivolta contro le tasse con i soldati."}, "ai": {"authority": 0.8, "aggression": 0.6}}]},
    {"id": "incendio_del_granaio", "category": "crisi", "title": "Il granaio brucia", "kind": "crisis", "weight": 4, "cooldown_days": 2880, "text": "Di notte il granaio ha preso fuoco. Qualcuno dice che non è stato un caso.", "when": {"has_building": "granary", "max_trust": 50}, "options": [{"text": "Si cerchi il colpevole", "effects": {"stock": {"grain": -150}, "stability": 3, "trust": -3}, "ai": {"authority": 1.0}}, {"text": "Si pensi a chi ha fame", "effects": {"stock": {"grain": -150}, "trust": 3, "treasury": -30}, "ai": {"piety": 0.8, "caution": 0.4}}]},
    {"id": "coloni", "category": "popolazione", "title": "Coloni da oltre i monti", "kind": "good", "weight": 5, "cooldown_days": 1440, "text": "Quattro famiglie scappate da una guerra lontana chiedono terra da arare e un tetto per l'inverno.", "when": {"has_settlement": true, "at_peace": true, "min_trust": 55, "min_population": 15}, "options": [{"text": "Che restino", "effects": {"arrivals": 5, "stock": {"grain": -30}, "favour": {"people": 2}}, "ai": {"trade": 0.6, "piety": 0.4}}, {"text": "Non c'è terra per tutti", "effects": {"trust": -3, "favour": {"clergy": -3}}, "ai": {"caution": 0.8, "greed": 0.3}}]},
    {"id": "febbre_dei_bambini", "category": "popolazione", "title": "La febbre dei bambini", "kind": "crisis", "weight": 5, "cooldown_days": 2160, "text": "Una febbre che colpisce i più piccoli gira di casa in casa. Le madri non dormono.", "when": {"has_settlement": true, "min_population": 30}, "options": [{"text": "Si separino i malati", "effects": {"kill_people": 1, "trust": -4}, "ai": {"caution": 1.0}}, {"text": "Si chiami la guaritrice", "effects": {"kill_people": 2, "trust": -2, "favour": {"clergy": -3}}, "ai": {"trade": 0.3}}]},
    {"id": "giovani_in_citta", "category": "popolazione", "title": "I giovani vanno in città", "kind": "bad", "weight": 5, "cooldown_days": 1440, "text": "Alcuni ragazzi vogliono andare a imparare un mestiere in città: qui, dicono, c'è solo la zappa.", "when": {"has_settlement": true, "max_trust": 55, "min_population": 25}, "options": [{"text": "Che vadano", "effects": {"departures": 3, "trust": 2}, "ai": {"caution": 0.5}}, {"text": "Una bottega qui, con l'oro della corona", "effects": {"treasury": -60, "trust": 4, "favour": {"merchants": 4}}, "ai": {"trade": 1.0}}]},
    {"id": "anno_di_nozze", "category": "popolazione", "title": "Un anno di nozze", "kind": "good", "weight": 5, "cooldown_days": 1440, "text": "Raccolto buono e pace: quest'anno si sono sposate più coppie che in tutti gli anni passati.", "when": {"has_settlement": true, "min_trust": 65, "at_peace": true}, "options": [{"text": "Un dono a ogni coppia", "effects": {"treasury": -30, "trust": 6, "authority": 3}, "ai": {"trade": 0.4, "piety": 0.5}}, {"text": "Le nozze le paghi chi si sposa", "effects": {"trust": 2}, "ai": {"greed": 0.8}}]},

    {"id": "banchetto", "category": "sovrano", "title": "Un banchetto di sette giorni", "kind": "bad", "weight": 6, "cooldown_days": 1440, "text": "Chi regna ha voluto una festa che si ricordi: cacciagione, musici, vino di tre paesi. I conti arrivano dopo.", "when": {"crowned": true, "ruler_trait": "scialacquatore", "min_treasury": 150}, "options": [{"text": "Si paghi tutto, e che se ne parli", "effects": {"treasury": -140, "prestige": 5, "favour": {"nobility": 8, "clergy": -4}}, "ai": {"greed": -0.6, "trade": 0.4}}, {"text": "Il tesoriere metta un freno", "effects": {"treasury": -40, "favour": {"nobility": -5}, "legitimacy": 3}, "ai": {"caution": 1.0}}]},
    {"id": "duello", "category": "sovrano", "title": "Una sfida a duello", "kind": "crisis", "weight": 5, "cooldown_days": 2160, "text": "Un signore ha offeso il sovrano davanti alla corte. Chi regna ha già la mano sulla spada.", "when": {"crowned": true, "ruler_trait": "impulsivo"}, "options": [{"text": "Si combatta all'alba", "effects": {"prestige": 8, "legitimacy": 4, "turbulence": 4, "favour": {"army": 6, "clergy": -4}}, "ai": {"aggression": 1.0}}, {"text": "Un sovrano non duella: lo si mandi in esilio", "effects": {"stability": 4, "favour": {"nobility": -5}}, "ai": {"caution": 1.0, "authority": 0.4}}]},
    {"id": "notte_insonne", "category": "sovrano", "title": "Notti insonni", "kind": "bad", "weight": 5, "cooldown_days": 1440, "text": "Chi regna non dorme più: fa cambiare le guardie ogni notte e legge le lettere dei suoi consiglieri.", "when": {"crowned": true, "ruler_trait": "sospettoso"}, "options": [{"text": "Si scelgano guardie nuove, straniere", "effects": {"treasury": -60, "stability": 4, "favour": {"nobility": -6, "army": -3}}, "ai": {"authority": 1.0}}, {"text": "Il confessore gli parli", "effects": {"favour": {"clergy": 5}, "legitimacy": 2}, "ai": {"piety": 1.0}}]},
    {"id": "libro_prezioso", "category": "sovrano", "title": "Un libro dall'oriente", "kind": "good", "weight": 5, "cooldown_days": 2160, "text": "Un mercante porta un libro di numeri e di stelle scritto in una lingua che a corte solo il sovrano sa leggere.", "when": {"crowned": true, "ruler_trait": "colto", "min_treasury": 100}, "options": [{"text": "Si compri, e lo si faccia copiare", "effects": {"treasury": -90, "research": 70, "prestige": 3}, "ai": {"authority": 0.5, "trade": 0.5}}, {"text": "Un libro non sfama nessuno", "effects": {"favour": {"people": 2}}, "ai": {"greed": 0.8}}]},
    {"id": "cantiere_del_re", "category": "sovrano", "title": "Il ponte del re", "kind": "good", "weight": 5, "cooldown_days": 2160, "text": "Chi regna ha disegnato con le sue mani un ponte di pietra sul fiume, e vuole vederlo finito prima di morire.", "when": {"crowned": true, "ruler_trait": "costruttore", "capital_river": true, "min_treasury": 150}, "options": [{"text": "Si costruisca", "effects": {"treasury": -150, "stock": {"stone": -40}, "prestige": 6, "legitimacy": 3, "crisis": {"id": "ponte_del_re", "name": "Il ponte del re", "days": 3600, "modifiers": [{"key": "trade.income", "op": "mul", "value": 1.1}]}, "chronicle": "Sul fiume si alza il ponte voluto dal sovrano."}, "ai": {"authority": 0.6, "trade": 0.5}}, {"text": "Ci sono cose più urgenti", "effects": {"legitimacy": -3, "favour": {"merchants": 3}}, "ai": {"caution": 0.8}}]},
    {"id": "voto_del_sovrano", "category": "sovrano", "title": "Il voto", "kind": "good", "weight": 5, "cooldown_days": 2880, "once": true, "text": "Dopo una malattia, chi regna ha fatto voto di fondare un monastero. Il clero aspetta che lo mantenga.", "when": {"crowned": true, "ruler_trait": "zelante"}, "options": [{"text": "Si mantenga il voto", "effects": {"treasury": -120, "legitimacy": 6, "research": 30, "favour": {"clergy": 12, "merchants": -3}}, "ai": {"piety": 1.0}}, {"text": "Un voto fatto con la febbre non vale", "effects": {"legitimacy": -5, "favour": {"clergy": -10}}, "ai": {"greed": 0.8}}]}
  ]
}

