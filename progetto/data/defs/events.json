    { "id": "nobile_ribelle", "category": "dinastia", "title": "Un nobile che non si presenta", "kind": "crisis", "weight": 8, "cooldown_days": 1440,
      "text": "Un signore delle terre di confine non manda più né uomini né tributi, e si dice tenga corte come un re.",
